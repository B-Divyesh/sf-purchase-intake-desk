{
  "name": "purchase-intake-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite",
    "dev:api": "cargo run --manifest-path api/Cargo.toml",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "npm run test:web && npm run test:api",
    "test:web": "vitest run",
    "test:api": "cargo test --manifest-path api/Cargo.toml",
    "test:e2e": "playwright test",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "cargo build --manifest-path api/Cargo.toml --release"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "26.4.0",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
